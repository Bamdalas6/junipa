# Live research runs on Claude with web search. Without this key the app runs in demo mode.
ANTHROPIC_API_KEY=
# Gemini research engine. When set, it is used instead of Claude.
GEMINI_API_KEY=
# Strongly recommended with Gemini: live web search, so competitors, prospects and
# decision makers come from real search results instead of the model's memory.
# Free plan: 1,000 searches a month, about 25-35 per full campaign (30-40 campaigns), https://app.tavily.com
TAVILY_API_KEY=
# "Continue with Google" sign-in. Google Cloud > APIs & Services > Credentials > OAuth client ID
# (Web application), redirect URI {site}/api/auth/google/callback. Without these, only email sign-up shows.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Who can open the /admin visit dashboard: comma-separated emails. They must sign in with
# Google (so the email is verified); anyone else gets "page not found".
ADMIN_EMAILS=
# "Forgot password?" emails, sent with Resend (resend.com > API Keys; verify junipa.app under Domains).
# Without a key, development prints reset links to the server console and production hides the option.
RESEND_API_KEY=
# Optional sender, default "Junia <no-reply@junipa.app>". Its domain must be verified in Resend.
EMAIL_FROM=
# Optional: verified work emails for decision makers (hunter.io domain search).
HUNTER_API_KEY=
# Optional: override the model (default claude-opus-5-5).
REACHLY_MODEL=
# Payments. Bachs is used when its key is set (Paystack otherwise); with neither, the paywall offers a test unlock.
# Bachs secret key from app.bachs.io > Developers: sk_sandbox_... for testing, sk_live_... for real payments.
BACHS_SECRET_KEY=
# Optional, for local testing only: Bachs won't send buyers back to localhost, so give it a public URL (e.g. a tunnel).
BACHS_RETURN_URL=
PAYSTACK_SECRET_KEY=
# Signs unlock tokens and seals locked plans. REQUIRED in production: a long random string
# (e.g. node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))").
REACHLY_SIGNING_SECRET=
# Free "test unlock" works only locally while Paystack isn't set. Set to 1 to allow it on a deployed test site.
REACHLY_ALLOW_TEST_UNLOCK=
# Public URL for payment redirects. Set this in production, e.g. https://junia.app
REACHLY_PUBLIC_URL=
# Subscriptions: the four recurring products created in Bachs (Products > New, with a billing cycle).
# Subscriptions switch on once all four are set. To change a price later, create a new product and
# point the setting at it: existing subscribers stay on their old product, so founding members keep their price.
BACHS_PRODUCT_STARTER_MONTHLY=
BACHS_PRODUCT_STARTER_YEARLY=
BACHS_PRODUCT_PRO_MONTHLY=
BACHS_PRODUCT_PRO_YEARLY=
# Prices shown on the site, in US dollars. Keep them equal to the Bachs products' prices.
REACHLY_PRICE_STARTER_MONTHLY=19
REACHLY_PRICE_STARTER_YEARLY=209
REACHLY_PRICE_PRO_MONTHLY=49
REACHLY_PRICE_PRO_YEARLY=539
# Pro follow-ups made due per user per day by the hourly scheduler.
FOLLOW_UP_DAILY_LIMIT=30
# Older per-campaign prices (still honoured for campaigns bought before subscriptions).
REACHLY_PRICE_STARTER_USD=19
REACHLY_PRICE_PRO_USD=49
# Social growth plan price in US dollars (one-time, unlocks the same handles for 30 days).
REACHLY_PRICE_SOCIAL_USD=9
# Founding-customer offer: percent off every plan at checkout (e.g. 50). Remove it once the spots are taken.
REACHLY_FOUNDING_DISCOUNT=
REACHLY_FOUNDING_SPOTS=20
# Where "How did Junia do?" testimonials are emailed (shown after a paid campaign).
NEXT_PUBLIC_FEEDBACK_EMAIL=
