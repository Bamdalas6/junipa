// Cloudflare Workers config for Junia (built with @opennextjs/cloudflare).
// Secrets (API keys) are not in this file: set them in the Cloudflare dashboard
// (Worker > Settings > Variables and Secrets) or with `npx wrangler secret put NAME`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "junipa",
  // custom-worker.ts wraps .open-next/worker.js (the Next.js app) and adds the follow-up cron.
  "main": "custom-worker.ts",
  "compatibility_date": "2026-10-01",
  // nodejs_compat: Node APIs (crypto, streams) for the Next.js server.
  // global_fetch_strictly_public: fetch() can only reach the public internet,
  // so research can never be pointed at internal addresses.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Accounts, sessions and saved workspaces (tables are created on first use).
  // The code reads it as env.DB, so keep the binding name.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "junia-db",
      "database_id": "dcfd77d1-a47a-496c-9d46-43316a344f01"
    }
  ],
  // Soft, approximate rate limits per visitor (see src/lib/ratelimit.ts). Each counts per
  // key per Cloudflare location; period can only be 10 or 60 seconds. namespace_id just has
  // to be unique in the account (1002 was an account limiter, now counted in D1).
  "ratelimits": [
    { "name": "AUTH_IP_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    { "name": "RUN_IP_LIMITER", "namespace_id": "1003", "simple": { "limit": 30, "period": 60 } }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "junipa"
    }
  ],
  // No "limits" here: the Free plan rejects any CPU setting. On Workers Paid the
  // default 30 s of CPU per request is plenty (research mostly waits on the network).
  // Every hour: scheduled follow-ups whose day has come become "due" (see src/lib/followups-cron.ts).
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
